# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production - ignore everything except build folder
/build

# Source files - keep local only
/src
/public
/package.json
/package-lock.json
/README.md

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Allow only build folder
!/build
!/build/**
